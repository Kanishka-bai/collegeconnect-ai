# CollegeConnect AI - Environment Configuration Template
# Copy this file to .env and configure your variables

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CollegeConnect AI"

# AI Provider Configuration
# Options: "mock" (offline/zero-cost demo), "gemini" (Google Gemini), "openai" (OpenAI)
AI_PROVIDER=mock

# Google Gemini API Key (if using gemini provider)
# Get a key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_SIZE_BYTES=10240

# Database
DATABASE_PATH=collegeconnect.db
